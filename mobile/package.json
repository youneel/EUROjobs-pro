{
  "name": "eurojobs-pro-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "EuroJobs Pro iOS shell (Capacitor) for App Store distribution.",
  "type": "module",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "generate:icon": "node scripts/generate-icon.mjs",
    "generate:assets": "npm run generate:icon && capacitor-assets generate --ios",
    "add:ios": "npm run prepare:web && cap add ios",
    "sync": "npm run prepare:web && cap sync ios",
    "open:ios": "cap open ios",
    "screenshots": "node appstore/capture-screenshots.mjs",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@types/node": "^26.6.6",
    "playwright": "^1.64.1",
    "sharp": "0.35.5",
    "typescript": "^7.0.2"
  }
}
