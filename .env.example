# ---------------------------------------------------------------------------
# WorkAtlas — copy this file to .env and fill in what you have.
# Everything except SECRET_KEY has a safe default; missing source keys are
# skipped gracefully and the site keeps working.
# ---------------------------------------------------------------------------

# Web
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/workatlas.db
# Optional. Used only if you later swap the in-process quota manager for Redis.
REDIS_URL=
ENABLE_SCHEDULER=true
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# AI — Google Gemini (free tier, Google AI Studio)
# Get a free key: https://aistudio.google.com/app/apikey  (no billing needed)
#
# Model IDs are intentionally configurable because Google renames/retires
# models often. Verify the CURRENT free-tier models and limits before changing:
#   https://ai.google.dev/gemini-api/docs/models
#   https://ai.google.dev/gemini-api/docs/rate-limits
#   https://aistudio.google.com/app/rate-limit   (your project's live limits)
# Do NOT default to Pro models: they are paid-tier. Flash-Lite has the largest
# free daily allowance and is the best FAST choice.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_QUALITY=gemini-2.5-flash
# true = Google's free tier (inputs may be used to improve products and may be
# reviewed by humans). Set to false only if you enable billing.
GEMINI_FREE_TIER=true

# Read your real numbers in AI Studio and put them here. Defaults are
# deliberately conservative. Daily counters reset at midnight Pacific time.
LLM_RPM_FAST=10
LLM_RPD_FAST=200
LLM_RPM_QUALITY=5
LLM_RPD_QUALITY=50
LLM_USER_DAILY_LIMIT=20
# Fraction of each model's daily quota that background jobs may use (0.2 = 20%)
LLM_BACKGROUND_SHARE=0.2
# Optional alternative providers behind the same interface.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Job + volunteer sources. Each adapter is enabled only when its key exists.
# Never add scrapers for LinkedIn / Indeed / Glassdoor.
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
RAPIDAPI_KEY=
REED_API_KEY=
RELIEFWEB_APPNAME=
# Optional comma separated ReliefWeb country ISO3 codes (empty = worldwide)
RELIEFWEB_COUNTRIES=
# Optional third-party logo service (e.g. Logo.dev). The fallback chain works
# without it.
LOGO_SERVICE_TOKEN=
LOGO_SERVICE_URL=https://img.logo.dev/{domain}?token={token}&size=128

# Ingestion / maintenance
INGEST_INTERVAL_MINUTES=20
LINK_CHECK_INTERVAL_HOURS=6
LOGO_CACHE_DIR=./static/logos
LOGO_REFRESH_DAYS=30

# Localisation
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=ar,fr,en

# ---------------------------------------------------------------------------
# iPhone / App Store
# PUBLIC_BASE_URL is the public HTTPS origin of this deployment. It is used in
# App Store links, the AASA file and notification payloads.
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=https://app.workatlas.pro
SUPPORT_EMAIL=support@workatlas.pro
IOS_BUNDLE_ID=com.workatlas.app
# Your 10-character Apple Developer Team ID. Required for universal links.
APPLE_TEAM_ID=
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_STORE_URL=

# APNs is optional. The in-app notifications card stays hidden until all four
# values are present. Use an APNs auth key (.p8) from Apple Developer.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=com.workatlas.app

# Safety
MAX_UPLOAD_MB=5
